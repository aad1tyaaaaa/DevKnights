# Shared access key: when set, every /api route requires the X-Provenyx-Key header.
# Leave unset only on a trusted local machine.
# PROVENYX_API_KEY=
# Scan and trust-gate submissions per client address per minute (0 = unlimited).
# PROVENYX_SUBMISSION_RATE_LIMIT_PER_MINUTE=30

# Copy to backend/.env and adjust. The backend always loads that file regardless of its launch directory.
# All values are optional; defaults are shown. Relative file paths are resolved from the backend directory.

# Comma-separated list of browser origins allowed to call the API (the local dashboard).
# Never use "*" outside local development.
PROVENYX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum accepted size of a POST /api/scans request body, in bytes (10 MiB).
PROVENYX_MAX_SCAN_BYTES=10485760

# Local scan snapshots. This resolves to backend/provenyx.db from every launch directory.
PROVENYX_DATABASE_URL=sqlite:///./provenyx.db

# Public npm metadata lookup limits.
PROVENYX_NPM_REGISTRY_URL=https://registry.npmjs.org
PROVENYX_NPM_REGISTRY_CONCURRENCY=10
PROVENYX_NPM_REGISTRY_TIMEOUT_SECONDS=5
PROVENYX_NPM_REGISTRY_RETRIES=2

# Exact-version known-vulnerability lookup. Only package names and versions are sent to OSV.
PROVENYX_OSV_API_URL=https://api.osv.dev
PROVENYX_OSV_CONCURRENCY=10
PROVENYX_OSV_TIMEOUT_SECONDS=5
PROVENYX_OSV_RETRIES=2

# Optional Gemini reranking. Disabled by default; deterministic evidence-backed scores remain authoritative.
# Only finding summaries are sent, never lockfiles, graph data, or raw evidence.
PROVENYX_AI_RANKING_ENABLED=false
# PROVENYX_GEMINI_API_KEY=enter-locally-never-commit
PROVENYX_GEMINI_MODEL=gemini-2.5-flash
PROVENYX_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
PROVENYX_GEMINI_TIMEOUT_SECONDS=10

# OpenRouter LLM Connector: simplifies scan changes and findings into plain language for end users.
# Multiple comma-separated keys will be automatically rotated to prevent quota exhaustion.
# PROVENYX_OPENROUTER_API_KEYS=sk-or-v1-...,sk-or-v1-...
# PROVENYX_OPENROUTER_API_KEY=sk-or-v1-...
PROVENYX_OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
PROVENYX_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PROVENYX_OPENROUTER_TIMEOUT_SECONDS=15
PROVENYX_OPENROUTER_DEFAULT_LANGUAGE=English

# Optional GitHub repository import. Create a GitHub OAuth App with:
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:8000/api/github/auth/callback
# PROVENYX_GITHUB_CLIENT_ID=your-oauth-app-client-id
# PROVENYX_GITHUB_CLIENT_SECRET=enter-locally-never-commit
# Generate with: openssl rand -hex 32
# PROVENYX_GITHUB_SESSION_SECRET=enter-locally-never-commit
# Where sign-in returns to. In production set only this (e.g. https://provenyx.vercel.app):
# the callback URL becomes <frontend>/api/github/auth/callback, cookies become Secure, and
# the URL is added to the CORS origins. Override either below only if you need to.
PROVENYX_FRONTEND_URL=http://localhost:3000
# PROVENYX_GITHUB_CALLBACK_URL=http://localhost:8000/api/github/auth/callback
# PROVENYX_SECURE_COOKIES=false

# Release registry (Phase 6). Local Hardhat chain only; read-only, no private keys.
PROVENYX_REGISTRY_RPC_URL=http://127.0.0.1:8545
# Defaults to <repo>/contracts/deployments/localhost.json (written by `npm --prefix contracts run deploy:local`).
# PROVENYX_REGISTRY_DEPLOYMENT_FILE=../contracts/deployments/localhost.json
# Or set the contract address directly instead of reading the deployment file:
# PROVENYX_REGISTRY_ADDRESS=0x...
PROVENYX_REGISTRY_TIMEOUT_SECONDS=3
