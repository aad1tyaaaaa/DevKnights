{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Provenyx Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "${workspaceFolder}/demo/sample-project"
      ],
      "outFiles": ["${workspaceFolder}/extension/dist/**/*.js"],
      "preLaunchTask": "provenyx: build extension"
    }
  ]
}
